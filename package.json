{
  "name": "obsidian-e-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read EPUBs and PDFs in your vault, with a Bases-backed library.",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production && node scripts/check-bundle-size.mjs",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "sync:pdf-css": "node scripts/sync-pdf-css.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "typescript": "^5",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.2.108"
  }
}
